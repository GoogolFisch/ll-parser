
Rnull      = null
Rtrue      = true
Rfalse     = false

RNeg       = \-
RSpace     = [\n\s\t\r]*
RSpaceP    = [\n\s\t\r]+
RComment   = \/\/[^\n\r]*
RQuot      = \"
REsc       = \\
RNum       = [0-9]+
RStrBody   = [^\\\"]+
RStrEsc    = \\.
RDot       = \.
RListOpen  = \[
RListClose = \]
RObjOpen   = \{
RObjDel    = \:
RObjClose  = \}
RComma     = \,


_ > Element

Space            > SpaceBody?
SpaceBody        > RComment SpaceBody?
SpaceBody        > RSpaceP  SpaceBody?

Element          > Space. StrHead Space.
Element          > Space. NumHead Space.
Element          > Space. ObjHead Space.
Element          > Space. LstHead Space.
Element          > Space. Rnull   Space.
Element          > Space. Boolean Space.

Boolean          > Rtrue
Boolean          > Rfalse


StrHead          > RQuot. StrBody@*? RQuot.
StrBody          > RStrBody StrBody*?
StrBody          > RStrEsc StrBody*?

NumHead          > RNeg? Space. RNum Space. NumFrac*?
NumHead          > RNeg? Space. RDot Space. RNum
NumFrac          > RDot  Space. RNum?

ObjHead          > RObjOpen. Space. ObjList*?  RObjClose.
ObjElement       > Space. StrHead Space. RObjDel. Space. Element RSpace. 
ObjList          > ObjElement ObjListContinue*? Space.
ObjListContinue  > RComma. Space. ObjList*?

LstHead          > RListOpen. Space. ListList*? RListClose.
ListList         > Space. Element ListListContinue*? Space.
ListListContinue > Space. RComma. ListList*?
